{
  "name": "iocalc-agent-env",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT-0 OR Apache-2.0",
  "description": "Open-source IOCALC agent environment protocol, adapters, conformance tests, and MCP bridge.",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm build && pnpm -r check && pnpm license:check",
    "contracts:generate": "pnpm build && node tools/generate_contract_snapshots.mjs",
    "contracts:check": "pnpm contracts:generate && git diff --exit-code -- schemas",
    "license:check": "node tools/license_check.mjs",
    "mcp:inspect": "pnpm --filter @iocalc/mcp-server build && npx @modelcontextprotocol/inspector node packages/mcp-server/dist/stdio.js",
    "pack:dry-run": "pnpm build && node tools/package_dry_run.mjs",
    "smoke": "pnpm build && node tests/smoke.mjs",
    "test": "pnpm -r test && pnpm smoke"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
